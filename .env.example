# Go API base URL (no trailing slash). Production builds require https://
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Chat WebSocket URL - use wss:// in production
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/communication/ws/v2

# Razorpay public key (checkout disabled without it)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: support phone shown in promo bar / footer
NEXT_PUBLIC_SUPPORT_PHONE=

# Optional: comma-separated HTTPS hostnames for next/image remote patterns
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: Sentry DSN for error monitoring
NEXT_PUBLIC_SENTRY_DSN=
